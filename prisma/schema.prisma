generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  TEAM_MEMBER
}

enum AlumniSource {
  ADMIN
  SELF_SUBMITTED
}

enum ArticleType {
  ARTICLE
  NEWSLETTER
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         UserRole  @default(TEAM_MEMBER)
  teamMember   TeamMember? @relation(fields: [teamMemberId], references: [id])
  teamMemberId String?   @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model TeamMember {
  id            String       @id @default(cuid())
  slug          String       @unique
  name          String
  credentials   String?
  title         String?
  bio           String?
  photoUrl      String?
  email         String?
  phone         String?
  linkedinUrl   String?
  twitterUrl    String?
  facebookUrl   String?
  isPartner     Boolean      @default(false)
  featuredHome  Boolean      @default(false)
  homeOrder     Int          @default(0)
  displayOrder  Int          @default(0)
  published     Boolean      @default(true)
  dealHistory   DealRecord[]
  user          User?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([featuredHome, homeOrder])
  @@index([published, displayOrder])
}

model DealRecord {
  id           String     @id @default(cuid())
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  teamMemberId String
  title        String
  description  String?
  practiceArea String?
  year         String?
  order        Int        @default(0)
  createdAt    DateTime   @default(now())

  @@index([teamMemberId])
}

model Alumni {
  id                 String       @id @default(cuid())
  name               String
  photoUrl           String?
  roleAtFirm         String?
  yearsAtFirm        String?
  currentRole        String?
  currentOrganization String?
  country            String?
  bio                String?
  linkedinUrl        String?
  source             AlumniSource @default(ADMIN)
  approved           Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([approved])
}

model Article {
  id             String      @id @default(cuid())
  slug           String      @unique
  title          String
  type           ArticleType @default(ARTICLE)
  summary        String?
  body           String?
  fileUrl        String?
  coverImageUrl  String?
  externalUrl    String?
  author         String?
  published      Boolean     @default(false)
  publishedAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([published, publishedAt])
  @@index([type])
}
